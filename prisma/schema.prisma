// MJ platform — database schema (R1 scope).
// Money is stored as whole somoni (Int). Times are stored in UTC; the salon runs on Asia/Dushanbe (UTC+5).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Access ──────────────────────────────────────────────

enum Role {
  OWNER
  RECEPTION
  CONTENT
  MASTER
}

model User {
  id           String    @id @default(cuid())
  name         String
  login        String    @unique
  passwordHash String
  role         Role
  staff        Staff?    @relation(fields: [staffId], references: [id])
  staffId      String?   @unique
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ─── Team & services ─────────────────────────────────────

model Staff {
  id          String   @id @default(cuid())
  name        String
  title       String
  /// Working weekdays, 0 = Monday … 6 = Sunday
  workDays    Int[]
  commission  Int      @default(40) /// percent of service revenue
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  user        User?
  appointments AppointmentStaff[]
  sales       Sale[]
  services    Service[] @relation("ServiceStaff")
  favouriteOf Guest[]   @relation("FavouriteMaster")
}

model ServiceCategory {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  /// Lucide icon key: scissors | hand | eye | droplet | sparkles | brush | crown
  icon      String
  sortOrder Int       @default(0)
  services  Service[]
}

model Service {
  id          String          @id @default(cuid())
  category    ServiceCategory @relation(fields: [categoryId], references: [id])
  categoryId  String
  name        String
  durationMin Int
  price       Int
  showOnSite  Boolean         @default(true)
  showInPos   Boolean         @default(false)
  /// Online bookings pay this share in advance (0 = no prepayment)
  depositPercent Int          @default(0)
  sortOrder   Int             @default(0)
  active      Boolean         @default(true)
  appointments Appointment[]
  saleItems   SaleItem[]
  /// Masters qualified to perform this service
  staff       Staff[]         @relation("ServiceStaff")
}

// ─── Guests & bookings ───────────────────────────────────

enum GuestTag {
  NEW
  REGULAR
  VIP
  BRIDE
}

model Guest {
  id           String        @id @default(cuid())
  name         String
  phone        String        @unique
  birthday     DateTime?     @db.Date
  tag          GuestTag      @default(NEW)
  notes        String?
  createdAt    DateTime      @default(now())
  appointments Appointment[]
  sales        Sale[]
  dressBookings DressBooking[]
  requests     BookingRequest[]
  telegramChats TelegramChat[]
  /// Master the guest marked as favourite in her account
  favouriteStaff   Staff?  @relation("FavouriteMaster", fields: [favouriteStaffId], references: [id], onDelete: SetNull)
  favouriteStaffId String?
  sessions      GuestSession[]
  /// Language of messages to her: ru | tg | en (last used on the website or in the bot)
  lang          String         @default("ru")
}

/// Website account session of a guest (signed in with a code sent to her phone).
model GuestSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  guestId   String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

/// One-time sign-in code. Only its hash is stored.
model LoginCode {
  id        String    @id @default(cuid())
  phone     String
  codeHash  String
  channel   String    /// telegram | whatsapp | sms
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([phone, createdAt])
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_CHAIR
  DONE
  CANCELLED
  NO_SHOW
}

enum BookingSource {
  CMS
  WEBSITE
  TELEGRAM
  WHATSAPP
  WALK_IN
}

model Appointment {
  id          String             @id @default(cuid())
  guest       Guest?             @relation(fields: [guestId], references: [id])
  guestId     String?
  /// Display name, also used for group or unregistered guests ("Подружки ×3")
  guestName   String
  service     Service?           @relation(fields: [serviceId], references: [id])
  serviceId   String?
  /// Display label; may differ from the service name ("СВАДЬБА: образ под ключ")
  serviceLabel String
  startsAt    DateTime
  durationMin Int
  price       Int
  status      AppointmentStatus  @default(PENDING)
  source      BookingSource      @default(CMS)
  note        String?
  createdAt   DateTime           @default(now())
  staff       AppointmentStaff[]
  /// When the day-before and hours-before reminders were queued
  remindedDayAt   DateTime?
  remindedHoursAt DateTime?
  /// Prepayment asked for online (somoni) and paid so far
  depositRequired Int       @default(0)
  depositPaid     Int       @default(0)
  /// An online booking waiting for its prepayment holds the time until then; afterwards it is released
  holdUntil       DateTime?
  payments        Payment[]

  @@index([startsAt])
}

model AppointmentStaff {
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  appointmentId String
  staff         Staff       @relation(fields: [staffId], references: [id])
  staffId       String

  @@id([appointmentId, staffId])
}

// ─── Till ────────────────────────────────────────────────

enum PaymentMethod {
  CASH
  CARD
  QR
}

model Sale {
  id        String        @id @default(cuid())
  /// Human-readable receipt number ("Чек №1042")
  number    Int           @unique @default(autoincrement())
  guest     Guest?        @relation(fields: [guestId], references: [id])
  guestId   String?
  staff     Staff?        @relation(fields: [staffId], references: [id])
  staffId   String?
  /// Value of the services (revenue)
  total     Int
  /// Paid now with the method below = total − prepayment − gift certificate
  paid      Int           @default(0)
  depositAmount  Int      @default(0)
  giftCardAmount Int      @default(0)
  method    PaymentMethod
  createdAt DateTime      @default(now())
  items     SaleItem[]
  redemptions GiftRedemption[]

  @@index([createdAt])
}

model SaleItem {
  id        String   @id @default(cuid())
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleId    String
  service   Service? @relation(fields: [serviceId], references: [id])
  serviceId String?
  name      String
  price     Int
}

// ─── Dress rental ────────────────────────────────────────

enum DressType {
  WEDDING
  EVENING
}

enum DressStatus {
  AVAILABLE
  CLEANING
  RETIRED
}

model Dress {
  id          String         @id @default(cuid())
  name        String
  type        DressType
  size        String
  pricePerDay Int
  status      DressStatus    @default(AVAILABLE)
  photoUrl    String?
  sortOrder   Int            @default(0)
  bookings    DressBooking[]
}

model DressBooking {
  id        String   @id @default(cuid())
  dress     Dress    @relation(fields: [dressId], references: [id])
  dressId   String
  guest     Guest?   @relation(fields: [guestId], references: [id])
  guestId   String?
  startsOn  DateTime @db.Date
  endsOn    DateTime @db.Date
  createdAt DateTime @default(now())
}

// ─── Salon settings & reminders ──────────────────────────

model Setting {
  key   String @id
  value Json
}

model Reminder {
  id        String   @id @default(cuid())
  text      String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ─── Website content (edited in /admin) ──────────────────

/// Two documents: "draft" (what the admin edits) and "published" (what the website shows).
/// Shape: SiteContent in src/lib/site-content.ts
model SiteDocument {
  id          String   @id /// draft | published
  data        Json
  updatedAt   DateTime @updatedAt
  updatedBy   String?
}

enum RequestStatus {
  NEW
  CALLED
  BOOKED
  DECLINED
}

/// "Онлайн-запись" form on the website (real-time slots replace it in R1 Sprint 5)
model BookingRequest {
  id        String        @id @default(cuid())
  name      String
  phone     String
  date      DateTime      @db.Date
  service   String
  status    RequestStatus @default(NEW)
  guest     Guest?        @relation(fields: [guestId], references: [id])
  guestId   String?
  createdAt DateTime      @default(now())

  @@index([status, createdAt])
}

// ─── Telegram bot ────────────────────────────────────────

/// A Telegram chat with the salon bot (a guest, or a staff chat that receives reception alerts).
/// Simulator chats from the CMS use ids starting with "sim-".
model TelegramChat {
  id        String   @id /// Telegram chat id
  guest     Guest?   @relation(fields: [guestId], references: [id])
  guestId   String?
  firstName String?
  username  String?
  /// Conversation state of the bot (current step and choices)
  state     Json     @default("{}")
  isStaff   Boolean  @default(false)
  /// Bot language chosen by the guest (null = not chosen yet, taken from Telegram)
  lang      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guestId])
}

// ─── Integrations (mock first) ───────────────────────────

enum IntegrationMode {
  MOCK
  LIVE
}

model Integration {
  key       String          @id /// telegram | whatsapp | sms | payments
  mode      IntegrationMode @default(MOCK)
  enabled   Boolean         @default(true)
  /// Non-secret settings only. Secrets live in server env.
  config    Json            @default("{}")
  updatedAt DateTime        @updatedAt
}

enum OutboxStatus {
  QUEUED
  SENT
  FAILED
}

model OutboxMessage {
  id        String       @id @default(cuid())
  channel   String       /// telegram | whatsapp | sms
  to        String
  body      String
  status    OutboxStatus @default(QUEUED)
  mock      Boolean      @default(true)
  error     String?
  meta      Json?
  createdAt DateTime     @default(now())
  sentAt    DateTime?

  @@index([createdAt])
}

// ─── Payments, gift certificates (R3) ────────────────────

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum PaymentPurpose {
  DEPOSIT
  GIFT_CARD
}

/// Money received outside a receipt: online prepayments and certificate sales (online or at the till).
model Payment {
  id            String         @id @default(cuid())
  purpose       PaymentPurpose
  amount        Int
  status        PaymentStatus  @default(PENDING)
  /// test (test checkout) | pos (at the till) | bank name when a live acquiring contract exists
  provider      String         @default("test")
  /// At the till: cash / card / QR
  method        PaymentMethod?
  externalId    String?
  description   String
  /// Where the guest returns after paying (path on the website)
  returnPath    String?
  lang          String         @default("ru")
  appointment   Appointment?   @relation(fields: [appointmentId], references: [id])
  appointmentId String?
  giftCard      GiftCard?      @relation(fields: [giftCardId], references: [id])
  giftCardId    String?
  createdAt     DateTime       @default(now())
  paidAt        DateTime?
  expiresAt     DateTime

  @@index([status, createdAt])
}

enum GiftCardStatus {
  PENDING
  ACTIVE
  USED
  CANCELLED
}

model GiftCard {
  id            String           @id @default(cuid())
  /// Printed on the certificate: MJ-XXXX-XXXX
  code          String           @unique
  /// Secret part of the link to the PDF and balance page
  token         String           @unique
  amount        Int
  balance       Int
  status        GiftCardStatus   @default(PENDING)
  recipientName String
  message       String?
  buyerName     String
  buyerPhone    String?
  lang          String           @default("ru")
  soldVia       String           /// WEBSITE | CMS
  soldBy        String?
  expiresAt     DateTime
  createdAt     DateTime         @default(now())
  payments      Payment[]
  redemptions   GiftRedemption[]
}

model GiftRedemption {
  id         String   @id @default(cuid())
  giftCard   GiftCard @relation(fields: [giftCardId], references: [id])
  giftCardId String
  sale       Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleId     String
  amount     Int
  createdAt  DateTime @default(now())
}
