// MJ platform — database schema (R1 scope).
// Money is stored as whole somoni (Int). Times are stored in UTC; the salon runs on Asia/Dushanbe (UTC+5).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Access ──────────────────────────────────────────────

enum Role {
  OWNER
  RECEPTION
  CONTENT
  MASTER
}

model User {
  id           String    @id @default(cuid())
  name         String
  login        String    @unique
  passwordHash String
  role         Role
  staff        Staff?    @relation(fields: [staffId], references: [id])
  staffId      String?   @unique
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ─── Team & services ─────────────────────────────────────

model Staff {
  id          String   @id @default(cuid())
  name        String
  title       String
  /// Working weekdays, 0 = Monday … 6 = Sunday
  workDays    Int[]
  commission  Int      @default(40) /// percent of service revenue
  /// Fixed monthly pay on top of the commission (0 = commission only)
  salary      Int      @default(0)
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  /// Personal code she sends the bot once as "/master CODE" to get her own bookings there
  botCode     String?  @unique
  user        User?
  telegramChats TelegramChat[]
  appointments AppointmentStaff[]
  sales       Sale[]
  services    Service[] @relation("ServiceStaff")
  favouriteOf Guest[]   @relation("FavouriteMaster")
  adjustments StaffAdjustment[]
  payouts     StaffPayout[]
  formulas    ColourFormula[]
  waitlist    WaitlistEntry[]
}

model ServiceCategory {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  /// Lucide icon key: scissors | hand | eye | droplet | sparkles | brush | crown
  icon      String
  sortOrder Int       @default(0)
  services  Service[]
}

model Service {
  id          String          @id @default(cuid())
  category    ServiceCategory @relation(fields: [categoryId], references: [id])
  categoryId  String
  name        String
  durationMin Int
  price       Int
  showOnSite  Boolean         @default(true)
  showInPos   Boolean         @default(false)
  /// Online bookings pay this share in advance (0 = no prepayment)
  depositPercent Int          @default(0)
  sortOrder   Int             @default(0)
  active      Boolean         @default(true)
  appointments Appointment[]
  saleItems   SaleItem[]
  /// Masters qualified to perform this service
  staff       Staff[]         @relation("ServiceStaff")
  waitlist    WaitlistEntry[]
  /// Consumables written off each time the service is paid
  consumption ServiceConsumption[]
}

// ─── Guests & bookings ───────────────────────────────────

enum GuestTag {
  NEW
  REGULAR
  VIP
  BRIDE
}

model Guest {
  id           String        @id @default(cuid())
  name         String
  phone        String        @unique
  birthday     DateTime?     @db.Date
  tag          GuestTag      @default(NEW)
  notes        String?
  /// Allergies and contraindications — shown as a warning wherever she is booked
  allergies    String?
  createdAt    DateTime      @default(now())
  appointments Appointment[]
  sales        Sale[]
  dressBookings DressBooking[]
  bridalPackages BridalPackage[]
  requests     BookingRequest[]
  telegramChats TelegramChat[]
  /// Master the guest marked as favourite in her account
  favouriteStaff   Staff?  @relation("FavouriteMaster", fields: [favouriteStaffId], references: [id], onDelete: SetNull)
  favouriteStaffId String?
  sessions      GuestSession[]
  /// Language of messages to her: ru | tg | en (last used on the website or in the bot)
  lang          String         @default("ru")
  /// Bonus points (1 point = 1 somoni); the ledger is BonusTx
  bonusBalance  Int            @default(0)
  bonusTxs      BonusTx[]
  formulas      ColourFormula[]
  photos        GuestPhoto[]
  waitlist      WaitlistEntry[]
}

/// Website account session of a guest (signed in with a code sent to her phone).
model GuestSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  guestId   String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

/// One-time sign-in code. Only its hash is stored.
model LoginCode {
  id        String    @id @default(cuid())
  phone     String
  codeHash  String
  channel   String    /// telegram | whatsapp | sms
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([phone, createdAt])
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_CHAIR
  DONE
  CANCELLED
  NO_SHOW
}

enum BookingSource {
  CMS
  WEBSITE
  TELEGRAM
  WHATSAPP
  WALK_IN
}

model Appointment {
  id          String             @id @default(cuid())
  guest       Guest?             @relation(fields: [guestId], references: [id])
  guestId     String?
  /// Display name, also used for group or unregistered guests ("Подружки ×3")
  guestName   String
  service     Service?           @relation(fields: [serviceId], references: [id])
  serviceId   String?
  /// Display label; may differ from the service name ("СВАДЬБА: образ под ключ")
  serviceLabel String
  startsAt    DateTime
  durationMin Int
  price       Int
  status      AppointmentStatus  @default(PENDING)
  source      BookingSource      @default(CMS)
  note        String?
  createdAt   DateTime           @default(now())
  staff       AppointmentStaff[]
  /// When the day-before and hours-before reminders were queued
  remindedDayAt   DateTime?
  remindedHoursAt DateTime?
  /// Prepayment asked for online (somoni) and paid so far
  depositRequired Int       @default(0)
  depositPaid     Int       @default(0)
  /// An online booking waiting for its prepayment holds the time until then; afterwards it is released
  holdUntil       DateTime?
  payments        Payment[]
  /// Promotion or promo code applied to the price (price before it in fullPrice)
  promotion       Promotion? @relation(fields: [promotionId], references: [id])
  promotionId     String?
  fullPrice       Int?
  photos          GuestPhoto[]
  formulas        ColourFormula[]
  waitlistOffer   WaitlistEntry? @relation("WaitlistOffer")

  @@index([startsAt])
}

model AppointmentStaff {
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  appointmentId String
  staff         Staff       @relation(fields: [staffId], references: [id])
  staffId       String

  @@id([appointmentId, staffId])
}

// ─── Till ────────────────────────────────────────────────

enum PaymentMethod {
  CASH
  CARD
  QR
}

model Sale {
  id        String        @id @default(cuid())
  /// Human-readable receipt number ("Чек №1042")
  number    Int           @unique @default(autoincrement())
  guest     Guest?        @relation(fields: [guestId], references: [id])
  guestId   String?
  staff     Staff?        @relation(fields: [staffId], references: [id])
  staffId   String?
  /// Value of the services (revenue)
  total     Int
  /// Paid now with the method below = total − prepayment − gift certificate
  paid      Int           @default(0)
  depositAmount  Int      @default(0)
  giftCardAmount Int      @default(0)
  /// Paid with bonus points, and points earned for this receipt
  bonusAmount    Int      @default(0)
  bonusEarned    Int      @default(0)
  method    PaymentMethod
  createdAt DateTime      @default(now())
  items     SaleItem[]
  stockMoves  StockMove[]
  redemptions GiftRedemption[]
  bonusTxs    BonusTx[]

  @@index([createdAt])
}

model SaleItem {
  id        String   @id @default(cuid())
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleId    String
  service   Service? @relation(fields: [serviceId], references: [id])
  serviceId String?
  name      String
  price     Int
  /// Discount by a promotion already taken off the price
  discount    Int        @default(0)
  promotion   Promotion? @relation(fields: [promotionId], references: [id])
  promotionId String?
}

// ─── Dress rental ────────────────────────────────────────

enum DressType {
  WEDDING
  EVENING
}

enum DressStatus {
  AVAILABLE
  CLEANING
  RETIRED
}

model Dress {
  id          String         @id @default(cuid())
  name        String
  type        DressType
  size        String
  pricePerDay Int
  status      DressStatus    @default(AVAILABLE)
  photoUrl    String?
  sortOrder   Int            @default(0)
  bookings    DressBooking[]
  bridalPackages BridalPackage[]
}

model DressBooking {
  id        String   @id @default(cuid())
  dress     Dress    @relation(fields: [dressId], references: [id])
  dressId   String
  guest     Guest?   @relation(fields: [guestId], references: [id])
  guestId   String?
  startsOn  DateTime @db.Date
  endsOn    DateTime @db.Date
  /// Booked as part of a bridal package
  bridalPackage   BridalPackage? @relation(fields: [bridalPackageId], references: [id], onDelete: SetNull)
  bridalPackageId String?
  createdAt DateTime @default(now())
}

// ─── Salon settings & reminders ──────────────────────────

model Setting {
  key   String @id
  value Json
}

model Reminder {
  id        String   @id @default(cuid())
  text      String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ─── Website content (edited in /admin) ──────────────────

/// Two documents: "draft" (what the admin edits) and "published" (what the website shows).
/// Shape: SiteContent in src/lib/site-content.ts
model SiteDocument {
  id          String   @id /// draft | published
  data        Json
  updatedAt   DateTime @updatedAt
  updatedBy   String?
}

enum RequestStatus {
  NEW
  CALLED
  BOOKED
  DECLINED
}

/// "Онлайн-запись" form on the website (real-time slots replace it in R1 Sprint 5)
model BookingRequest {
  id        String        @id @default(cuid())
  name      String
  phone     String
  date      DateTime      @db.Date
  service   String
  status    RequestStatus @default(NEW)
  guest     Guest?        @relation(fields: [guestId], references: [id])
  guestId   String?
  createdAt DateTime      @default(now())

  @@index([status, createdAt])
}

// ─── Telegram bot ────────────────────────────────────────

/// A Telegram chat with the salon bot (a guest, or a staff chat that receives reception alerts).
/// Simulator chats from the CMS use ids starting with "sim-".
model TelegramChat {
  id        String   @id /// Telegram chat id
  guest     Guest?   @relation(fields: [guestId], references: [id])
  guestId   String?
  firstName String?
  username  String?
  /// Conversation state of the bot (current step and choices)
  state     Json     @default("{}")
  isStaff   Boolean  @default(false)
  /// Set by "/master CODE": this chat is a master's own, and receives her bookings
  staff     Staff?   @relation(fields: [staffId], references: [id])
  staffId   String?
  /// Bot language chosen by the guest (null = not chosen yet, taken from Telegram)
  lang      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guestId])
  @@index([staffId])
}

// ─── Integrations (mock first) ───────────────────────────

enum IntegrationMode {
  MOCK
  LIVE
}

model Integration {
  key       String          @id /// telegram | whatsapp | sms | payments
  mode      IntegrationMode @default(MOCK)
  enabled   Boolean         @default(true)
  /// Non-secret settings only. Secrets live in server env.
  config    Json            @default("{}")
  updatedAt DateTime        @updatedAt
}

enum OutboxStatus {
  QUEUED
  SENT
  FAILED
}

model OutboxMessage {
  id        String       @id @default(cuid())
  channel   String       /// telegram | whatsapp | sms
  to        String
  body      String
  status    OutboxStatus @default(QUEUED)
  mock      Boolean      @default(true)
  error     String?
  meta      Json?
  createdAt DateTime     @default(now())
  sentAt    DateTime?

  @@index([createdAt])
}

// ─── Payments, gift certificates (R3) ────────────────────

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum PaymentPurpose {
  DEPOSIT
  GIFT_CARD
}

/// Money received outside a receipt: online prepayments and certificate sales (online or at the till).
model Payment {
  id            String         @id @default(cuid())
  purpose       PaymentPurpose
  amount        Int
  status        PaymentStatus  @default(PENDING)
  /// test (test checkout) | pos (at the till) | bank name when a live acquiring contract exists
  provider      String         @default("test")
  /// At the till: cash / card / QR
  method        PaymentMethod?
  externalId    String?
  description   String
  /// Where the guest returns after paying (path on the website)
  returnPath    String?
  lang          String         @default("ru")
  appointment   Appointment?   @relation(fields: [appointmentId], references: [id])
  appointmentId String?
  giftCard      GiftCard?      @relation(fields: [giftCardId], references: [id])
  giftCardId    String?
  createdAt     DateTime       @default(now())
  paidAt        DateTime?
  expiresAt     DateTime

  @@index([status, createdAt])
}

enum GiftCardStatus {
  PENDING
  ACTIVE
  USED
  CANCELLED
}

model GiftCard {
  id            String           @id @default(cuid())
  /// Printed on the certificate: MJ-XXXX-XXXX
  code          String           @unique
  /// Secret part of the link to the PDF and balance page
  token         String           @unique
  amount        Int
  balance       Int
  status        GiftCardStatus   @default(PENDING)
  recipientName String
  message       String?
  buyerName     String
  buyerPhone    String?
  lang          String           @default("ru")
  soldVia       String           /// WEBSITE | CMS
  soldBy        String?
  expiresAt     DateTime
  createdAt     DateTime         @default(now())
  payments      Payment[]
  redemptions   GiftRedemption[]
}

model GiftRedemption {
  id         String   @id @default(cuid())
  giftCard   GiftCard @relation(fields: [giftCardId], references: [id])
  giftCardId String
  sale       Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleId     String
  amount     Int
  createdAt  DateTime @default(now())
}

// ─── Bonus program and promotions (R3) ───────────────────

enum BonusKind {
  EARN
  SPEND
  BIRTHDAY
  WELCOME
  MANUAL
}

/// Every change of a guest's points; Guest.bonusBalance is the running total.
model BonusTx {
  id        String    @id @default(cuid())
  guest     Guest     @relation(fields: [guestId], references: [id], onDelete: Cascade)
  guestId   String
  delta     Int
  kind      BonusKind
  sale      Sale?     @relation(fields: [saleId], references: [id], onDelete: SetNull)
  saleId    String?
  note      String?
  createdBy String?
  createdAt DateTime  @default(now())

  @@index([guestId, createdAt])
}

enum PromotionKind {
  PERCENT
  FIXED
}

/// An offer (applied automatically in its dates) or a promo code (applied when entered).
model Promotion {
  id            String        @id @default(cuid())
  title         String
  titleTg       String?
  titleEn       String?
  description   String?
  descriptionTg String?
  descriptionEn String?
  kind          PromotionKind
  value         Int
  /// Services it covers; empty = all
  serviceIds    String[]
  startsOn      DateTime      @db.Date
  endsOn        DateTime      @db.Date
  /// Promo code (upper case); null = automatic offer
  code          String?       @unique
  active        Boolean       @default(true)
  showOnSite    Boolean       @default(true)
  usageLimit    Int?
  usedCount     Int           @default(0)
  createdAt     DateTime      @default(now())
  appointments  Appointment[]
  saleItems     SaleItem[]
}

// ─── Payroll and the till ────────────────────────────────

/// A bonus (+) or a fine (−) for a master in a month
model StaffAdjustment {
  id        String   @id @default(cuid())
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  staffId   String
  /// "YYYY-MM"
  month     String
  amount    Int
  note      String
  createdBy String?
  createdAt DateTime @default(now())

  @@index([staffId, month])
}

/// Money paid to a master for a month: an advance or the final payment
model StaffPayout {
  id        String        @id @default(cuid())
  staff     Staff         @relation(fields: [staffId], references: [id], onDelete: Cascade)
  staffId   String
  month     String
  amount    Int
  /// CASH taken from the till (counted in that day's shift), CARD = bank transfer
  method    PaymentMethod
  note      String?
  paidBy    String?
  paidAt    DateTime      @default(now())
  movement  CashMovement?

  @@index([staffId, month])
}

/// Cash put into (+) or taken out of (−) the till during the day, not from a receipt
model CashMovement {
  id            String       @id @default(cuid())
  /// Salon calendar day
  day           DateTime     @db.Date
  amount        Int
  note          String
  payout        StaffPayout? @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  payoutId      String?      @unique
  createdBy     String?
  createdAt     DateTime     @default(now())

  @@index([day])
}

/// End-of-day shift close: the day's totals as they were when it was closed, and the cash count
model CashShift {
  id           String   @id @default(cuid())
  day          DateTime @unique @db.Date
  openingCash  Int
  cashSales    Int
  cardSales    Int
  qrSales      Int
  cashIn       Int
  cashOut      Int
  expectedCash Int
  countedCash  Int
  difference   Int
  /// Taken from the drawer at closing (handed to the owner / bank)
  handedOver   Int
  /// Left in the drawer for tomorrow
  leftCash     Int
  receipts     Int
  revenue      Int
  /// Breakdown kept for the Z-report (prepayments, certificates, points, discounts, by master)
  details      Json
  note         String?
  closedBy     String
  closedAt     DateTime @default(now())
}

// ─── Guest card: colour formulas and photos ──────────────

/// A colour (or lash / brow tint) formula written after a visit
model ColourFormula {
  id            String       @id @default(cuid())
  guest         Guest        @relation(fields: [guestId], references: [id], onDelete: Cascade)
  guestId       String
  staff         Staff?       @relation(fields: [staffId], references: [id], onDelete: SetNull)
  staffId       String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  appointmentId String?
  /// What it was for: "Окрашивание корней", "Тонирование"
  title         String
  /// The mix: "Igora 7-1 + 7-0 1:1, оксид 6%, 35 мин"
  formula       String
  note          String?
  createdBy     String?
  createdAt     DateTime     @default(now())

  @@index([guestId, createdAt])
}

enum GuestPhotoKind {
  BEFORE
  AFTER
  OTHER
}

/// A before/after photo. Private: stored outside the public media folder, shown only in the CMS.
model GuestPhoto {
  id            String         @id @default(cuid())
  guest         Guest          @relation(fields: [guestId], references: [id], onDelete: Cascade)
  guestId       String
  appointment   Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  appointmentId String?
  kind          GuestPhotoKind @default(OTHER)
  /// File name in MEDIA_DIR/private
  file          String
  caption       String?
  createdBy     String?
  createdAt     DateTime       @default(now())

  @@index([guestId, createdAt])
}

// ─── Waitlist and walk-ins ───────────────────────────────

enum WaitlistKind {
  /// Wants a time on a day that is full: offered the first matching time that frees up
  WAITLIST
  /// Came in without a booking and waits in the salon today
  WALK_IN
}

enum WaitlistStatus {
  WAITING
  /// A freed time is held for her until offerExpiresAt
  OFFERED
  BOOKED
  /// Walk-in seated
  SERVED
  /// Walk-in left without service
  LEFT
  DECLINED
  EXPIRED
  CANCELLED
}

model WaitlistEntry {
  id             String         @id @default(cuid())
  kind           WaitlistKind   @default(WAITLIST)
  status         WaitlistStatus @default(WAITING)
  guest          Guest?         @relation(fields: [guestId], references: [id], onDelete: SetNull)
  guestId        String?
  name           String
  phone          String?
  lang           String         @default("ru")
  service        Service        @relation(fields: [serviceId], references: [id])
  serviceId      String
  /// Wanted master; null = any
  staff          Staff?         @relation(fields: [staffId], references: [id], onDelete: SetNull)
  staffId        String?
  /// Salon day she wants
  date           DateTime       @db.Date
  /// Preferred window "HH:MM" (optional)
  timeFrom       String?
  timeTo         String?
  note           String?
  source         BookingSource  @default(CMS)
  /// Secret for the accept / decline page sent to her
  token          String         @unique
  /// The held booking offered to her
  offer          Appointment?   @relation("WaitlistOffer", fields: [offerId], references: [id], onDelete: SetNull)
  offerId        String?        @unique
  offerExpiresAt DateTime?
  offers         Int            @default(0)
  createdBy      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status, date])
}

// ─── Stock and consumables ───────────────────────────────

/// A product or consumable kept in stock, counted in its smallest unit (ml, g, pcs)
model StockItem {
  id          String   @id @default(cuid())
  name        String
  /// мл | г | шт
  unit        String
  category    String   @default("Расходники")
  quantity    Int      @default(0)
  /// Alert when the quantity drops below this
  minQuantity Int      @default(0)
  /// One package: how many units and what it costs (for the stock value)
  packSize    Int      @default(1)
  packPrice   Int      @default(0)
  supplier    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  moves       StockMove[]
  consumption ServiceConsumption[]
}

/// How much of an item one service uses (written off when the service is paid)
model ServiceConsumption {
  service   Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceId String
  item      StockItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId    String
  amount    Int

  @@id([serviceId, itemId])
}

enum StockMoveKind {
  /// Delivery
  RECEIPT
  /// Used by a paid service
  SERVICE
  /// Thrown away, broken, expired, own use
  WASTE
  /// Stocktake: set to the counted quantity
  COUNT
}

model StockMove {
  id        String        @id @default(cuid())
  item      StockItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId    String
  delta     Int
  /// Quantity after the move
  balance   Int
  kind      StockMoveKind
  sale      Sale?         @relation(fields: [saleId], references: [id], onDelete: SetNull)
  saleId    String?
  note      String?
  createdBy String?
  createdAt DateTime      @default(now())

  @@index([itemId, createdAt])
  @@index([createdAt])
}

// ─── Bridal packages ─────────────────────────────────────

enum BridalStatus {
  NEW
  CONFIRMED
  DONE
  CANCELLED
}

/// A bride's package put together on the website (or by reception): services for the wedding day,
/// a dress from the rental and a trial look before the wedding.
model BridalPackage {
  id           String        @id @default(cuid())
  number       Int           @unique @default(autoincrement())
  status       BridalStatus  @default(NEW)
  guest        Guest?        @relation(fields: [guestId], references: [id], onDelete: SetNull)
  guestId      String?
  name         String
  phone        String
  lang         String        @default("ru")
  weddingDate  DateTime      @db.Date
  /// [{ serviceId, name, price }]
  services     Json
  dress        Dress?        @relation(fields: [dressId], references: [id], onDelete: SetNull)
  dressId      String?
  dressDays    Int           @default(0)
  dressPrice   Int           @default(0)
  subtotal     Int
  discountPercent Int        @default(0)
  total        Int
  /// The trial look booked with the package
  trialAppointmentId String?
  note         String?
  source       BookingSource @default(WEBSITE)
  createdAt    DateTime      @default(now())
  dressBookings DressBooking[]
}

// ─── Blog ────────────────────────────────────────────────

enum PostStatus {
  DRAFT
  PUBLISHED
}

/// A beauty tip / article for /blog. Russian in the main fields; Tajik and English in i18n (empty = Russian).
model BlogPost {
  id          String     @id @default(cuid())
  slug        String     @unique
  status      PostStatus @default(DRAFT)
  title       String
  excerpt     String     @default("")
  /// Light markup: paragraphs, "## " headings, "- " lists, "> " quotes, **bold**, [links](https://…)
  body        String     @default("")
  /// { tg: { title, excerpt, body }, en: { … } }
  i18n        Json       @default("{}")
  coverUrl    String?
  tags        String[]
  /// "Записаться" under the article goes to this service
  serviceId   String?
  publishedAt DateTime?
  createdBy   String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status, publishedAt])
}
