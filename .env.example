# Copy to .env and adjust.

# Postgres (docker compose exposes it on 5432)
POSTGRES_USER=mj
POSTGRES_PASSWORD=mj-local-password
POSTGRES_DB=mj
DATABASE_URL=postgresql://mj:mj-local-password@localhost:5432/mj

# Public domain served by Caddy (use "localhost" for local runs)
SITE_DOMAIN=localhost

# Uploaded photos (a Docker volume in production)
MEDIA_DIR=./media

# Seed: first owner login (change the password after first sign-in)
SEED_OWNER_LOGIN=mavzuna
SEED_OWNER_PASSWORD=change-me-now
# Optional: anchor date for demo data, YYYY-MM-DD (defaults to today in Dushanbe)
SEED_TODAY=

# Guest account on the website: show sign-in codes on screen while channels are in mock mode.
# Set to 1 only on demo/staging servers (anyone could open any guest's account). Always on in development.
DEMO_LOGIN_CODES=

# Integrations — leave empty while running in mock mode
TELEGRAM_BOT_TOKEN=
# Bot username without @ (for the "Открыть бота" link in the guest account)
TELEGRAM_BOT_USERNAME=
# Any long random string; Telegram sends it back so the webhook can trust the request
TELEGRAM_WEBHOOK_SECRET=
# WhatsApp Cloud API (Meta): permanent access token, phone number id, app secret (checks webhook signatures)
# and any long random string you also enter as the webhook "Verify token" in Meta
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Optional: Graph API version (default v22.0) and the number that receives the CMS "Тест" message
WHATSAPP_API_VERSION=
WHATSAPP_TEST_TO=
SMS_API_KEY=
PAYMENTS_API_KEY=
